# Copy to config.local.env or export these variables before running.
# Do not store real passwords in source control.

POOL_TEST_USER=DRCP_CATALOG
POOL_TEST_PASSWORD=
POOL_TEST_CONNECT_STRING=YOUR_ADB_TP_ALIAS
POOL_TEST_TNS_ADMIN=/absolute/path/to/your/wallet_directory
POOL_TEST_ORACLE_CLIENT_MODE=thick
POOL_TEST_ORACLE_CLIENT_LIB_DIR=/usr/lib/oracle/21/client64/lib

# Optional. If set, the diagnostic will query Oracle evidence through the existing
# read-only ORDS dashboard endpoints instead of using database privileges.
POOL_TEST_ORDS_METRICS_BASE_URL=https://your-ords-host.example.com/ords/admin/drcp-demo/dashboard

# Workload defaults.
POOL_TEST_POOL_MIN=5
POOL_TEST_POOL_MAX=8
POOL_TEST_POOL_INCREMENT=1
POOL_TEST_POOL_TIMEOUT=60
POOL_TEST_POOL_COUNT=5
POOL_TEST_WARMUP_WAIT_MS=30000
POOL_TEST_SAMPLE_INTERVAL_MS=1000
POOL_TEST_SIZES=1,2,3,4,5,8,10
POOL_TEST_DEMO_WARMUP_ROUNDS=3
POOL_TEST_DEMO_WARMUP_CONCURRENCY=2
POOL_TEST_STOP_ON_FAILURE=true

# Optional. Defaults to the five schemas from ../config/services.json when present.
# POOL_TEST_SERVICE_USERS=DRCP_CATALOG,DRCP_INVENTORY,DRCP_ORDERS,DRCP_PAYMENTS,DRCP_CUSTOMERS
