PORT=8080
BENCHMARK_MODE=traditional
BENCHMARK_VERSION=1.0.0
BENCHMARK_SAMPLE_INTERVAL_MS=2000
BENCHMARK_WARMUP_SECONDS=10
BENCHMARK_DURATION_SECONDS=45
BENCHMARK_CONCURRENCY=6
APPLICATION_CONNECTION_BUDGET=20
BENCHMARK_REQUEST_DELAY_MS=100
BENCHMARK_WARMUP_DELAY_MS=250
# Use oracledb for a direct Node.js driver connection, or sqlcl to use saved SQLcl connections.
DB_DRIVER=oracledb
ORACLE_CLIENT_MODE=thick
ORACLE_CLIENT_LIB_DIR=/usr/lib/oracle/21/client64/lib
DEMO_CONNECT_STRING=YOUR_ADB_TP_ALIAS
DEMO_DRCP_CONNECT_STRING=YOUR_ADB_TP_POOLED_ALIAS
# Optional: point Node.js to the same wallet directory used by the SQLcl connection manager.
DEMO_TNS_ADMIN=/absolute/path/to/your/wallet_directory
ADMIN_USER=ADMIN
ADMIN_PASSWORD=
ADMIN_CONNECT_STRING=YOUR_ADB_TP_ALIAS
# Preferred dashboard monitoring source. Node proxies these ORDS endpoints to avoid
# browser CORS and to keep the frontend independent from database credentials.
ORDS_METRICS_BASE_URL=https://your-ords-host.example.com/ords/admin/drcp-demo/dashboard
DRCP_PASSWORD=replace_with_service_schema_password
# Traditional client-side pools use the production ADB baseline validated by pool_testing.
# With five services, TRADITIONAL_POOL_MIN=5 opens 25 dedicated sessions before workload.
TRADITIONAL_POOL_MIN=5
TRADITIONAL_POOL_MAX=8
# DRCP avoids per-service client-side minimum idle sessions. The shared database-resident
# pool keeps the conservative 2/8 sizing at the database-resident layer.
DRCP_POOL_MIN=0
DRCP_POOL_MAX=8
DRCP_RESIDENT_MIN=2
DRCP_RESIDENT_MAX=8
DRCP_DEFAULT_PURITY=POOLED
DRCP_TAGGING_STRATEGY=mixed
# Fallback used only when V$RESOURCE_LIMIT is not available through ORDS.
DB_SESSION_LIMIT=1000
DATABASE_CALL_TIMEOUT_MS=10000
POOL_INITIALIZE_TIMEOUT_MS=180000
POOL_INCREMENT=1
INITIALIZE_POOLS_ON_START=true
